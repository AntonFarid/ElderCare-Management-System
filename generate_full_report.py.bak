    add_heading(doc, "3.4  Sequence Diagrams", 2)
    add_heading(doc, "3.4.1  Authentication Sequence Diagram", 3)
    add_paragraph(doc, """
┌──────┐   ┌──────────┐   ┌─────────────────────┐   ┌────────────┐   ┌──────────┐
│Client│   │AuthCtrlr │   │AuthenticationService │   │UserManager │   │ JWT Util │
└──┬───┘   └────┬─────┘   └──────────┬──────────┘   └─────┬──────┘   └────┬─────┘
   │            │                    │                     │                │
   │ POST /login│                    │                     │                │
   │──────────►│                    │                     │                │
   │            │ LoginAsync(request)│                     │                │
   │            │──────────────────►│                     │                │
   │            │                   │FindByEmailAsync()    │                │
   │            │                   │────────────────────►│                │
   │            │                   │◄────────────────────│ return user    │
   │            │                   │ Check IsActive/Deleted                │
   │            │                   │CheckPasswordSignIn() │                │
   │            │                   │────────────────────►│                │
   │            │                   │◄──────────────────── result.Succeeded│
   │            │                   │ GenerateJwtToken()  │                │
   │            │                   │──────────────────────────────────────►
   │            │                   │◄────────────────────────────────── JWT token
   │            │                   │ UpdateLastLoginAt() │                │
   │            │                   │────────────────────►│                │
   │ 200 OK + JWT + UserInfo        │                     │                │
   │◄──────────│                    │                     │                │

Figure 3.4: Sequence Diagram – JWT Authentication Flow
""", size=8)

    add_heading(doc, "3.4.2  Daily Report Submission Sequence", 3)
    add_paragraph(doc, """
┌──────────┐  ┌──────────────┐  ┌────────────────┐  ┌────────────┐  ┌────────────┐  ┌───────────┐
│ Employee │  │EmployeeCtrlr │  │EmployeeService │  │GeminiService│  │AIPrediction│  │NotifService│
└────┬─────┘  └──────┬───────┘  └───────┬────────┘  └─────┬──────┘  └─────┬──────┘  └─────┬─────┘
     │                │                 │                  │               │               │
     │ POST /reports  │                 │                  │               │               │
     │───────────────►│                 │                  │               │               │
     │                │CreateDailyReport│                  │               │               │
     │                │────────────────►│                  │               │               │
     │                │                 │ Validate Employee│               │               │
     │                │                 │ Validate Elderly │               │               │
     │                │                 │ Save Report+Metrics              │               │
     │                │                 │ GenerateDailyReport              │               │
     │                │                 │────────────────►│                │               │
     │                │                 │◄─ AI Report Text │               │               │
     │                │                 │ PredictHealthRisk│               │               │
     │                │                 │──────────────────────────────────►              │
     │                │                 │◄────────────────── RiskLevel, Confidence        │
     │                │                 │ If High Risk: SendNotification                  │
     │                │                 │──────────────────────────────────────────────► │
     │                │                 │ Update AiGeneratedReport                        │
     │ 201 Created + Report DTO         │                  │               │               │
     │◄───────────────│                 │                  │               │               │

Figure 3.5: Sequence Diagram – Employee Daily Report Submission with AI Integration
""", size=8)

    add_heading(doc, "3.4.3  Report Approval Sequence", 3)
    add_paragraph(doc, """
┌────────────┐  ┌───────────────┐  ┌─────────────────┐  ┌──────────────┐  ┌─────────────┐
