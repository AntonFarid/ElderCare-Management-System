    add_heading(doc, "C.1  JWT Token Generation (AuthenticationService.cs)", 3)
    add_paragraph(doc, """private async Task<string> GenerateJwtTokenAsync(User user)
{
    var tokenHandler = new JwtSecurityTokenHandler();
    var key = Encoding.ASCII.GetBytes(_jwtSettings.Secret);
    var roles = await _userManager.GetRolesAsync(user);
    var claims = new List<Claim>
    {
        new(JwtRegisteredClaimNames.Sub, user.Id.ToString()),
        new(JwtRegisteredClaimNames.Email, user.Email!),
        new("userId", user.Id.ToString()),
        new("userType", user.UserType.ToString()),
        new("fullName", $"{user.FirstName} {user.LastName}")
    };
    claims.AddRange(roles.Select(role => new Claim(ClaimTypes.Role, role)));
    var tokenDescriptor = new SecurityTokenDescriptor
    {
        Subject = new ClaimsIdentity(claims),
        Expires = DateTime.UtcNow.AddMinutes(_jwtSettings.AccessTokenExpirationInMinutes),
        Issuer = _jwtSettings.Issuer,
        Audience = _jwtSettings.Audience,
        SigningCredentials = new SigningCredentials(
            new SymmetricSecurityKey(key), SecurityAlgorithms.HmacSha256Signature)
    };
    var token = tokenHandler.CreateToken(tokenDescriptor);
    return tokenHandler.WriteToken(token);
}""", size=9)

    add_heading(doc, "C.2  AI Health Risk Prediction (main.py – Python FastAPI)", 3)
    add_paragraph(doc, """@app.post("/api/ml/predict-health-risk", response_model=PredictionOutput)
def predict_health_risk(data: HealthDataInput, api_key: str = Depends(get_api_key)):
    # Temperature auto-conversion (Celsius → Fahrenheit)
    temp_f = (data.body_temperature * 9/5) + 32 if data.body_temperature < 45.0 else data.body_temperature
    
    # ML Prediction
    features = pd.DataFrame([{...}], columns=model_features)
    is_high_risk = bool(health_model.predict(features)[0] == 1)
    confidence = round(health_model.predict_proba(features)[0][1 if is_high_risk else 0], 2)
    
    # Clinical Rule Engine Overrides
    if data.systolic_bp >= 160 or data.diastolic_bp >= 100:
        is_high_risk = True; confidence = 0.99  # Severe Hypertension
    if data.heart_rate >= 115:
        is_high_risk = True; confidence = 0.99  # Tachycardia
    if temp_f >= 101.5:
        is_high_risk = True; confidence = 0.99  # High Fever
    if data.blood_sugar >= 200:
        is_high_risk = True; confidence = 0.99  # Hyperglycemia
    if data.missed_medications >= 2:
        is_high_risk = True; confidence = 0.99  # Non-adherence
    
    # Generate Markdown Clinical Report
    recommendation = compile_clinical_report(is_high_risk, anomalies, reasons, actions)
    log_prediction_to_csv(data.elderly_id, data, "High" if is_high_risk else "Low", confidence)
    
    return PredictionOutput(elderly_id=data.elderly_id, 
                           risk_level="High" if is_high_risk else "Low",
                           confidence_score=confidence, recommendation=recommendation)""", size=9)

