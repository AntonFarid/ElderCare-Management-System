    # ══════════════════════════════════════════════════════════════════════════
    # CHAPTER 4: IMPLEMENTATION
    # ══════════════════════════════════════════════════════════════════════════
    add_heading(doc, "Chapter 4: Implementation", 1)
    add_heading(doc, "4.1  Software Architecture", 2)
    add_heading(doc, "4.1.1  Architecture Overview", 3)
    add_paragraph(doc, """SmartElderlyCare is implemented using Clean Architecture (also known as Onion Architecture), which enforces a strict separation of concerns across four concentric layers. The core principle is that dependencies always point inward — outer layers depend on inner layers, but inner layers have no knowledge of outer layers. This enables independent testability, high maintainability, and technology-agnostic domain logic.""", size=11)

    add_paragraph(doc, "The four layers in the .NET backend are:", size=11, bold=True)
    layers = [
        ("Domain Layer (SmartElderlyCare.Domain)", "The innermost layer. Contains all business entities (User, Elderly, DailyReport, etc.), enumerations (UserType, ApprovalStatus, MetricType, etc.), interfaces (IRepository<T>, IUnitOfWork), common base classes (BaseEntity, IAuditableEntity), and business rules. Has zero external dependencies."),
        ("Application Layer (SmartElderlyCare.Application)", "The second layer. Contains Data Transfer Objects (DTOs) for all API operations, service interfaces (IAuthenticationService, IAdminService, etc.), AutoMapper mapping profiles, application exception classes, and wrapper types (Response<T>, PaginatedResponse<T>). Depends only on the Domain layer."),
        ("Infrastructure Layer (SmartElderlyCare.Infrastructure)", "The third layer. Contains the ApplicationDbContext (Entity Framework Core 8), all service implementations (AuthenticationService, AdminService, EmployeeService, TeamLeaderService, FamilyMemberService, GeminiService, NotificationService, EmailService, AiPredictionService), generic repository and unit-of-work implementations, EF Core migrations, and database seeding. Depends on Domain and Application layers."),
        ("API Layer (SmartElderlyCare.API)", "The outermost layer. Contains all ASP.NET Core controllers, the SignalR NotificationHub, middleware (GlobalExceptionHandlingMiddleware), extension methods (JWT authentication, Swagger), and the application entry point (Program.cs). Depends on all inner layers."),
    ]
    for name, desc in layers:
        add_bullet(doc, desc, bold_prefix=f"{name}: ")

    add_heading(doc, "4.1.2  Technology Stack", 3)
    tech_stack = [
        ("Backend Language", ".NET 8 / C# 12", "ASP.NET Core Web API"),
        ("Frontend Language", "JavaScript (ES2022)", "React.js 19 + Vite 8"),
        ("AI Service Language", "Python 3.10+", "FastAPI + Uvicorn"),
        ("Database", "Microsoft SQL Server 2019+", "Entity Framework Core 8 (Code-First)"),
        ("Authentication", "ASP.NET Core Identity + JWT", "HS256 HMAC Signing"),
        ("Real-Time Communication", "ASP.NET Core SignalR", "WebSocket transport"),
        ("AI / ML", "Scikit-Learn (Random Forest)", "joblib model persistence"),
        ("Generative AI", "Google Gemini Flash API", "gemini-flash-latest model"),
        ("Email", "SMTP (Gmail)", "System.Net.Mail / MailKit"),
        ("Frontend UI Library", "HeroUI (based on NextUI)", "React component library"),
        ("CSS Framework", "TailwindCSS 4", "Utility-first styling"),
        ("Charts", "Recharts", "React-based charting library"),
        ("HTTP Client (Frontend)", "Axios + TanStack Query v5", "API calls + server state"),
        ("Form Management", "React Hook Form + Zod", "Validation and schema enforcement"),
        ("Animation", "Framer Motion", "UI micro-animations"),
        ("Routing (Frontend)", "React Router DOM v7", "Client-side routing"),
        ("ORM", "Entity Framework Core 8", "LINQ-based data access"),
        ("Object Mapping", "AutoMapper", "DTO ↔ Entity mapping"),
        ("API Documentation", "Swagger / OpenAPI 3.0", "Swashbuckle.AspNetCore"),
        ("Version Control", "Git + GitHub", "Collaborative development"),
        ("Data Format (AI Reports)", "Markdown", "rendered via react-markdown"),
    ]
    add_styled_table(doc, ["Component", "Technology", "Details"], tech_stack)

    add_heading(doc, "4.1.3  Authentication and Authorization", 3)
    add_paragraph(doc, """Authentication is implemented using ASP.NET Core Identity integrated with JWT (JSON Web Tokens):

1. Registration: Employees are registered by Admins via POST /api/auth/register/employee. Family members self-register via POST /api/auth/register/family using an elderly resident's ConnectionCode.

2. Login: Users authenticate via POST /api/auth/login with email and password. The system verifies credentials using SignInManager.CheckPasswordSignInAsync() with lockout after 5 failed attempts.

3. JWT Generation: Upon successful authentication, a JWT is generated containing claims: userId, userType, fullName, email, and role claims. The token is signed using HmacSha256 with a 32+ character secret key and expires after 60 minutes.

4. Authorization: All controllers are protected with [Authorize] attributes. Role-based authorization is enforced at the controller and action level using [Authorize(Roles = "Admin")] etc. The CurrentUserService extracts the current user's ID from JWT claims at runtime.

5. Password Reset: A password reset flow is implemented using UserManager.GeneratePasswordResetTokenAsync() with token delivery via Gmail SMTP email containing a frontend reset URL.""", size=11)

    add_heading(doc, "4.1.4  Design Patterns Used", 3)
    patterns = [
        ("Repository Pattern", "Generic Repository<T> abstracts all database operations. Each entity type can be accessed through the repository without coupling business logic to EF Core directly."),
        ("Unit of Work Pattern", "IUnitOfWork coordinates multiple repository operations within a single database transaction, ensuring atomicity."),
        ("Dependency Injection (DI)", "All services, repositories, and infrastructure components are registered with ASP.NET Core's built-in IoC container and injected via constructor injection throughout the application."),
        ("Options Pattern", "JwtSettings, EmailSettings, and GeminiSettings are bound from appsettings.json and injected using IOptions<T>, supporting environment-specific configuration."),
        ("Wrapper Pattern", "All API responses are wrapped in a generic Response<T> class providing consistent structure with Succeeded, Data, Message, and Errors properties."),
        ("Middleware Pattern", "GlobalExceptionHandlingMiddleware intercepts all unhandled exceptions and converts them to structured JSON error responses with appropriate HTTP status codes."),
        ("Mediator-like Service Layer", "Each controller role (Admin, TeamLeader, Employee, Family) has a dedicated service class that encapsulates all business logic, keeping controllers thin and focused."),
        ("Factory/Builder (AI Reports)", "The GeminiService uses a prompt construction builder pattern to dynamically assemble structured prompts for Gemini AI based on report data."),
        ("Strategy Pattern (AI Fallback)", "The GeminiService implements a fallback strategy: if the Gemini API is unavailable, a template-based report generator is used automatically."),
    ]
    add_styled_table(doc, ["Pattern", "Application in SmartElderlyCare"], patterns)

    add_heading(doc, "4.2  Workflow / Pseudocode / Flowcharts", 2)
    add_heading(doc, "4.2.1  JWT Authentication Flowchart", 3)
    add_paragraph(doc, """
[User Submits Login Request: {email, password}]
              │
              ▼
[Find user by email in DB]
       ┌──────┴──────┐
    [Not Found]   [Found]
       │              │
  [401 Unauthorized]  │
                 [IsActive=false OR IsDeleted=true?]
                       ┌────────┴────────┐
                     [Yes]             [No]
                       │                │
               [401 Inactive]   [CheckPasswordSignIn()]
                                  ┌─────┴──────┐
                               [Fail]        [Success]
                                  │              │
                          [IsLockedOut?]  [GenerateJwtToken()]
                          ┌────┴─────┐         │
                        [Yes]      [No]   [UpdateLastLoginAt()]
                          │          │         │
                     [Locked Out]  [Increment  │
                     [Return 423] [FailCount]  │
                                    [Return 401]
                                         │
                               [Return 200 + JWT + UserInfo]
""", size=9)

    add_heading(doc, "4.2.2  AI Health Risk Prediction Algorithm (Pseudocode)", 3)
    add_paragraph(doc, """
FUNCTION predict_health_risk(data: HealthDataInput):
    
    // Step 1: Temperature Preprocessing
    IF data.body_temperature < 45.0:
        temp_fahrenheit = (data.body_temperature × 9/5) + 32
    ELSE:
        temp_fahrenheit = data.body_temperature
    
    // Step 2: Prepare ML Feature Vector
    features = [age, heart_rate, systolic_bp, diastolic_bp, blood_sugar, 
                temp_fahrenheit, mobility_score, sleep_hours, 
                missed_medications, meals_eaten_percent, mood_score]
    
    // Step 3: ML Model Prediction
    probabilities = health_risk_model.predict_proba(features)
    is_high_risk = (health_risk_model.predict(features) == 1)
    confidence = probabilities[1] if is_high_risk else probabilities[0]
    
    // Step 4: Clinical Rule Engine (Safety Overrides)
    IF systolic_bp >= 160 OR diastolic_bp >= 100:      // Severe Hypertension
        is_high_risk = TRUE; confidence = 0.99
    IF systolic_bp <= 85 OR diastolic_bp <= 50:        // Severe Hypotension
        is_high_risk = TRUE; confidence = 0.99
    IF heart_rate >= 115:                               // Tachycardia
        is_high_risk = TRUE; confidence = 0.99
    IF heart_rate <= 45:                               // Bradycardia
        is_high_risk = TRUE; confidence = 0.99
    IF temp_fahrenheit >= 101.5:                       // High Fever
        is_high_risk = TRUE; confidence = 0.99
    IF temp_fahrenheit <= 94.0:                        // Hypothermia
        is_high_risk = TRUE; confidence = 0.99
    IF blood_sugar >= 200:                             // Hyperglycemia
        is_high_risk = TRUE; confidence = 0.99
    IF blood_sugar <= 60:                              // Hypoglycemia
        is_high_risk = TRUE; confidence = 0.99
    IF missed_medications >= 2:                        // Non-adherence
        is_high_risk = TRUE; confidence = 0.99
    
    // Step 5: Generate Markdown Clinical Report
    report = compile_clinical_report(is_high_risk, anomalies, reasons, actions)
    
    // Step 6: Audit Logging
    log_prediction_to_csv(elderly_id, data, risk_level, confidence)
    
    // Step 7: Return Result
    RETURN {elderly_id, risk_level, confidence_score, recommendation}
""", size=9)

    add_heading(doc, "4.3  Module Implementation", 2)

    add_heading(doc, "4.3.1  User Management Module", 3)
    add_paragraph(doc, """The User Management module is implemented across the AuthController, AdminController, and their respective service classes. The module supports the complete lifecycle of user management:

- Admin creates users (employees) via POST /api/admin/users or registers them via POST /api/auth/register/employee
- Family members self-register via POST /api/auth/register/family with a connection code
- All passwords are hashed by ASP.NET Core Identity using PBKDF2 with HMACSHA256
- User accounts support soft-delete (IsDeleted = true) to preserve referential integrity
- Activation/Deactivation controls access without deleting accounts
- Role management supports assigning and removing roles via the Admin API
- Unique email constraint enforced at both application and database level""", size=11)

    add_heading(doc, "4.3.2  Health Monitoring Module", 3)
    add_paragraph(doc, """Health monitoring is implemented through the HealthMetric entity and the DailyReport management workflow:

- Employees submit structured health data including six metric types: Meals, Medications, Activities, Symptoms, Vitals, and Mood
- Each metric captures name, value, unit, notes, and recorded time
- The StructuredData field in DailyReport stores the raw JSON-formatted input for auditability
- Upon report submission, the backend automatically calls the Google Gemini AI service to generate a professional narrative report
- Simultaneously, the AI microservice is called to predict health risk based on the reported vitals
- High-risk predictions trigger immediate real-time SignalR notifications to all connected team leaders
- The FamilyMember portal provides health trend analysis via GET /family/elderly/{id}/health-trends and metric-specific trends via GET /family/elderly/{id}/metric-trends/{type}""", size=11)

    add_heading(doc, "4.3.3  AI Prediction Module (Python FastAPI)", 3)
    add_paragraph(doc, """The AI microservice is implemented as a standalone Python FastAPI application secured with X-API-Key authentication:

Health Risk Prediction (/api/ml/predict-health-risk):
- Input: 11 clinical parameters (age, heart rate, blood pressure (systolic/diastolic), blood sugar, body temperature, mobility score, sleep hours, missed medications, meals eaten percentage, mood score)
- Processing: Celsius-to-Fahrenheit auto-conversion, Random Forest ML prediction, Clinical Rule Engine overrides, Markdown report compilation
- Output: risk_level (High/Low), confidence_score (0-1), recommendation (Markdown clinical report)
- Audit: All predictions are logged to prediction_history.csv with timestamps

Diet Recommendation (/api/ml/recommend-diet):
- Input: Resident demographics (age, gender, height, weight), medical conditions, allergies, dietary restrictions, recent blood sugar and BP averages, meal intake percentage
- Processing: Feature encoding (gender, activity, dietary preference), BMI calculation, disease flag extraction, Random Forest meal prediction, allergen safety filter
- Output: Three personalised meal recommendations (breakfast, lunch, dinner) with macros, descriptions, and clinical dietitian notes in Markdown

Fall Detection (/api/ml/detect-fall):
- Input: Camera ID, frame reference, bounding box coordinates (x_min, y_min, x_max, y_max)
- Processing: Aspect ratio (dy/dx) heuristic — ratio < 0.85 indicates horizontal posture (fall)
- Output: fall_detected (bool), confidence_score, alert_message
- Note: Production version would use a real pose estimation model (YOLOv8-pose or MediaPipe)""", size=11)

    add_heading(doc, "4.3.4  Notification Module", 3)
    add_paragraph(doc, """The notification system combines in-database persistence with real-time SignalR push delivery:

Database Persistence:
- All notifications are stored in the Notifications table with type, title, message, IsRead status, and optional related entity reference
- Notification types: HealthAlert, ReportApproved, ReportRejected, VisitRequest, ScheduleChange, General

SignalR Real-Time Delivery:
- The NotificationHub (SignalR) is mapped to /notificationHub
- Upon connection, users are added to their personal group (user-{userId}) and role groups (admins, teamLeaders, employees, familyMembers)
- Notifications are sent to specific users via Clients.Group($"user-{userId}").SendAsync("ReceiveNotification", ...)
- The frontend subscribes to the "ReceiveNotification" event and displays toast notifications in real-time""", size=11)

    add_heading(doc, "4.3.5  Reporting Module (Gemini AI Integration)", 3)
    add_paragraph(doc, """The AI report generation module integrates Google Gemini API to produce professional care narratives:

1. Prompt Construction: The GeminiService builds a structured prompt containing the resident's name, report date, and all health metrics with their timestamps, values, units, and notes
2. Sections Requested: The prompt instructs Gemini to generate six sections: Summary, Medications, Meals, Activities, Observations, and Recommendations
3. API Call: The service sends a POST request to https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent with the X-goog-api-key header
4. Fallback: If the API call fails or returns an empty response, a template-based report is generated from the raw metrics without AI assistance
5. Pattern Detection: The GeminiService also supports pattern detection across multiple recent reports, identifying declining trends, recurring symptoms, and medication adherence issues""", size=11)

    add_heading(doc, "4.3.6  Administration Module", 3)
    add_paragraph(doc, """The Administration module (AdminController + AdminService) provides the following capabilities:

- Dashboard: Aggregated system statistics (total users by role, total elderly, active reports, pending visits, today's attendance)
- User Management: Full CRUD with pagination, filtering by UserType/IsActive, role assignment
- Elderly Management: Full CRUD with connection code generation, assignment management
- Assignments: Employee-to-elderly assignment management with primary caregiver designation
- Family Management: Family-to-elderly linkage with relationship type and visit permission management
- Visit Oversight: View all visit requests across the system with filtering
- Audit Logs: Query audit logs by date range, entity type, entity ID
- Activity Summary: Daily activity summary for any specified date""", size=11)

