        ("IT-003", "Employee Report Submission + Gemini AI", "Employee submits report → Gemini called → AI report stored in DailyReport.AiGeneratedReport", "Report contains AI-generated narrative in DB", "PASS"),
        ("IT-004", "Report Submission + AI Risk Prediction", "Employee submits report with abnormal vitals → AI microservice called → High risk detected", "Notification sent to TeamLeaders in real-time via SignalR", "PASS"),
        ("IT-005", "TeamLeader Approval + Family Notification", "TeamLeader approves report → Notification triggered → Family member notified", "Family member receives notification; report visible in portal", "PASS"),
        ("IT-006", "Family Visit Request + TeamLeader Approval", "Family submits visit → TeamLeader notified → TeamLeader approves → Family notified", "Visit status changes to Approved; family sees approval", "PASS"),
        ("IT-007", "Admin Create Elderly + Connection Code", "Admin creates elderly → ConnectionCode generated → Family uses code to register", "Family-elderly link created successfully in DB", "PASS"),
        ("IT-008", "Employee Clock In/Out + TeamLeader View", "Employee clocks in → TeamLeader views attendance/current-status", "Employee appears as Present in attendance dashboard", "PASS"),
        ("IT-009", "TeamLeader Diet Recommendation", "TeamLeader requests diet for elderly → .NET backend calls AI microservice → Response returned to frontend", "Personalised meal plan with dietitian notes displayed", "PASS"),
        ("IT-010", "Forgot Password Flow", "User requests password reset → Email sent with reset link → User clicks link → Resets password → Logs in", "New password accepted; user authenticated successfully", "PASS"),
    ]
    add_styled_table(doc, ["Test ID", "Test Case", "Steps", "Expected Result", "Status"], integration_tests)

