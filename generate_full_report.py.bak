    # CHAPTER 1: INTRODUCTION
    # ══════════════════════════════════════════════════════════════════════════
    add_heading(doc, "Chapter 1: Introduction", 1)
    add_heading(doc, "1.1  Overview", 2)
    add_paragraph(doc, """The global elderly population is growing at an unprecedented rate. According to the World Health Organization (WHO), the number of people aged 60 years or older is projected to reach 2.1 billion by 2050 — more than double the figure recorded in 2020. This demographic shift places enormous pressure on care facilities, healthcare providers, families, and information systems that must support the physical, medical, and emotional needs of elderly residents.

In Egypt and the broader Middle Eastern region, the challenge is further compounded by a growing gap between rising demand for professional eldercare services and the capacity of care facilities to deliver consistent, high-quality, and documented care. Existing systems — where they exist at all — are often paper-based, fragmented, poorly integrated, and lack any intelligent decision-support capabilities.

SmartElderlyCare, commercially branded as SilverNest, is a full-stack, AI-enhanced elder care management system developed as the graduation project of six students from the Department of Information Systems, Faculty of Computers and Information. The system is designed to address the pressing operational needs of elderly care facilities through a modern, web-based, role-aware platform that integrates data management, workflow automation, real-time communication, and artificial intelligence.

The system provides an integrated digital platform where care facility administrators, team leaders, caregiving employees, and family members all have their own tailored dashboards and functionality — enabling seamless coordination, transparent monitoring, and data-driven decision-making in eldercare.""", size=11)

    add_heading(doc, "1.2  Objectives", 2)
    objectives = [
        "To develop a fully functional, multi-role web-based management system for elderly care facilities.",
        "To implement an AI-powered health risk prediction engine capable of identifying high-risk residents based on vital signs, medication adherence, mobility, sleep, and mood.",
        "To integrate Google Gemini AI for intelligent, natural-language daily health report generation.",
        "To implement a machine learning-based personalised dietary recommendation engine tailored to each resident's medical history, allergies, and dietary restrictions.",
        "To deliver a real-time push notification system using ASP.NET Core SignalR for instantaneous health alerts and workflow events.",
        "To implement a complete digital workflow for report submission, review, and approval.",
        "To provide family members with transparent, controlled access to approved health reports and visit scheduling capabilities.",
        "To apply Clean Architecture, SOLID principles, and industry-grade security practices in system design.",
        "To demonstrate the successful integration of .NET 8, React.js 19, Python FastAPI, and multiple AI APIs in a cohesive full-stack project.",
    ]
    for obj in objectives:
        add_bullet(doc, obj)

    add_heading(doc, "1.3  Purpose", 2)
    add_paragraph(doc, """The primary purpose of this project is threefold:

First, to demonstrate academic mastery of the full software development lifecycle — from requirements analysis through architectural design, implementation, testing, and documentation — as part of the graduation requirements of the Department of Information Systems.

Second, to contribute a technically advanced, practically applicable software solution to the domain of eldercare management. The system is designed to be deployable in real care facilities, with production-grade features including JWT-based authentication, role-based access control (RBAC), soft-delete data management, global exception handling middleware, audit logging, and database migrations.

Third, to explore and apply modern AI and machine learning technologies within a healthcare context, demonstrating how trained classification models, large language models (Google Gemini), and intelligent rule engines can augment human caregiving with data-driven insights, while maintaining patient safety through clinical override protocols.""", size=11)

    add_heading(doc, "1.4  Scope", 2)
    add_paragraph(doc, "The SmartElderlyCare system encompasses the following functional scope:", size=11)
    
    scope_items = [
        ("User Management", "Full CRUD, role-based access (Admin, TeamLeader, Employee, FamilyMember), soft-delete, activation/deactivation, audit trails."),
        ("Elderly Resident Management", "Complete resident profiles including medical history, allergies, dietary restrictions, room assignment, emergency contacts, and unique connection codes for family self-registration."),
        ("Daily Health Reporting", "Structured health metric logging (vitals, medications, meals, activities, mood, symptoms) with Google Gemini AI-generated narrative reports."),
        ("AI Health Risk Prediction", "Custom-trained Random Forest classifier for high-risk prediction with hybrid clinical rule-based overrides for patient safety."),
        ("AI Dietary Recommendations", "ML-based personalised meal recommendations accounting for BMI, medical conditions, blood sugar trends, blood pressure trends, allergies, and dietary restrictions."),
        ("Report Approval Workflow", "Team leader review, approval, or rejection workflow with reason logging and notification triggers."),
        ("Visit Scheduling", "Family members can request, update, and cancel visits; team leaders approve or reject with reasons."),
        ("Work Schedule Management", "Team leaders create, update, and delete employee work schedules; employees view their own schedules."),
        ("Attendance Tracking", "Employee clock-in/clock-out with daily attendance logs and summary analytics."),
        ("Real-Time Notifications", "SignalR-based push notifications for health alerts, report approvals/rejections, visit decisions, and schedule changes."),
        ("Email Notifications", "SMTP email service for password reset functionality."),
        ("System Statistics and Dashboard", "Aggregated KPIs including total residents, active employees, pending reports, and attendance summaries."),
        ("Audit Logging", "Complete system-wide audit trail of all create, update, and delete actions with timestamps, user IDs, entity types, and change diffs."),
    ]

    scope_table_data = [(k, v) for k, v in scope_items]
    add_styled_table(doc, ["Module", "Scope Description"], scope_table_data)

    add_heading(doc, "1.5  General Constraints", 2)
    constraints = [
