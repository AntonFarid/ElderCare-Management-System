    # CHAPTER 3: SOFTWARE DESIGN
    # ══════════════════════════════════════════════════════════════════════════
    add_heading(doc, "Chapter 3: Software Design", 1)
    add_heading(doc, "3.1  Database Design", 2)
    add_heading(doc, "3.1.1  Entity-Relationship Diagram (ERD)", 3)

    add_paragraph(doc, "The SmartElderlyCare database is implemented using Microsoft SQL Server with Entity Framework Core Code-First migrations. The schema comprises 12 primary tables derived from the domain entity models, plus ASP.NET Core Identity tables for authentication and authorisation.", size=11)

    add_paragraph(doc, """
═══════════════════════════════════════════════════════════════════════
                    ENTITY-RELATIONSHIP DIAGRAM (ERD)
                      SmartElderlyCare Database Schema
═══════════════════════════════════════════════════════════════════════

┌─────────────────────────────┐
│          USERS              │◄────────────────────────────────────────┐
│─────────────────────────────│                                         │
│ Id (PK, INT, Identity)      │                                         │
│ FirstName (NVARCHAR 100)    │                                         │
│ LastName  (NVARCHAR 100)    │     ┌──────────────────────────────┐   │
│ Email (NVARCHAR, UNIQUE)    │     │     DAILY_REPORTS            │   │
│ PasswordHash (NVARCHAR)     │◄────│──────────────────────────────│   │
│ PhoneNumber (NVARCHAR)      │  1:N│ Id (PK, INT, Identity)       │   │
│ UserType (INT)              │     │ EmployeeId (FK→Users)        │   │
│ IsActive (BIT)              │     │ ElderlyId  (FK→Elderlies)    │   │
│ IsDeleted (BIT)             │     │ ReportDate (DATETIME)        │   │
│ CreatedAt (DATETIME)        │     │ SubmissionDate (DATETIME)    │   │
│ UpdatedAt (DATETIME?)       │     │ ApprovalStatus (INT)         │   │
│ LastLoginAt (DATETIME?)     │     │ ApprovedById (FK→Users, NULL)│   │
└─────────────────────────────┘     │ AiGeneratedReport (NTEXT)    │   │
         │                          │ StructuredData (NTEXT JSON)  │   │
         │1                         │ RejectionReason (NVARCHAR?)  │   │
         │                          └──────────────────────────────┘   │
         │N                                    │1                       │
         │                                     │N                       │
  ┌──────▼──────────────────────┐    ┌─────────▼─────────────────────┐ │
  │    WORK_SCHEDULES           │    │      HEALTH_METRICS            │ │
  │─────────────────────────────│    │────────────────────────────────│ │
  │ Id (PK)                     │    │ Id (PK)                       │ │
  │ EmployeeId (FK→Users)       │    │ DailyReportId (FK→DailyRpts)  │ │
  │ ShiftDate (DATE)            │    │ MetricType (INT: Enum)        │ │
  │ StartTime (TIME)            │    │ MetricName (NVARCHAR)         │ │
  │ EndTime (TIME)              │    │ MetricValue (NVARCHAR)        │ │
  │ ShiftType (INT: Enum)       │    │ Unit (NVARCHAR?)              │ │
  │ CreatedById (FK→Users)      │    │ Notes (NVARCHAR?)             │ │
  │ Notes (NVARCHAR?)           │    │ RecordedTime (TIME)           │ │
  └─────────────────────────────┘    └────────────────────────────────┘
  
  ┌──────────────────────────────┐
  │         ELDERLIES            │◄──────────────────────────────────────┐
  │──────────────────────────────│                                       │
  │ Id (PK, INT, Identity)       │   ┌────────────────────────────────┐  │
  │ FirstName (NVARCHAR 100)     │   │  EMPLOYEE_ELDERLY_ASSIGNMENTS  │  │
  │ LastName  (NVARCHAR 100)     │◄──│────────────────────────────────│  │
  │ DateOfBirth (DATETIME)       │N:M│ EmployeeId (PK, FK→Users)      │  │
  │ RoomNumber (NVARCHAR?)       │   │ ElderlyId  (PK, FK→Elderlies)  │  │
  │ EmergencyContact (NVARCHAR?) │   │ AssignedDate (DATETIME)        │──┘
  │ MedicalConditions (NTEXT?)   │   │ EndDate (DATETIME?)            │
  │ Allergies (NTEXT?)           │   │ IsPrimary (BIT)                │
  │ DietaryRestrictions (NTEXT?) │   └────────────────────────────────┘
  │ ProfileImageUrl (NVARCHAR?)  │
  │ ConnectionCode (CHAR 6)      │   ┌────────────────────────────────┐
  │ IsActive (BIT)               │   │   ELDERLY_FAMILY_MEMBERS       │
  │ IsDeleted (BIT)              │◄──│────────────────────────────────│
  └──────────────────────────────┘N:M│ ElderlyId (PK, FK→Elderlies)  │
                                     │ FamilyMemberId (PK, FK→Users)  │
  ┌───────────────────────────────┐   │ Relationship (NVARCHAR)        │
  │       VISIT_REQUESTS          │   │ IsPrimaryContact (BIT)         │
  │───────────────────────────────│   │ CanScheduleVisits (BIT)        │
  │ Id (PK)                       │   └────────────────────────────────┘
  │ FamilyMemberId (FK→Users)     │
  │ ElderlyId (FK→Elderlies)      │   ┌────────────────────────────────┐
  │ RequestedDate (DATE)          │   │       NOTIFICATIONS            │
  │ RequestedTime (TIME)          │   │────────────────────────────────│
  │ DurationMinutes (INT)         │   │ Id (PK)                       │
  │ Status (INT: Enum)            │   │ UserId (FK→Users, CASCADE)    │
  │ ApprovedById (FK→Users, NULL) │   │ Title (NVARCHAR)              │
  │ ApprovedDate (DATETIME?)      │   │ Message (NTEXT)               │
  │ Notes (NVARCHAR?)             │   │ NotificationType (INT: Enum)  │
  │ RejectionReason (NVARCHAR?)   │   │ IsRead (BIT)                  │
  └───────────────────────────────┘   │ RelatedEntityId (INT?)        │
                                      │ RelatedEntityType (NVARCHAR?) │
  ┌───────────────────────────────┐   └────────────────────────────────┘
  │       ATTENDANCE_LOGS         │
  │───────────────────────────────│   ┌────────────────────────────────┐
  │ Id (PK)                       │   │         AUDIT_LOGS             │
  │ EmployeeId (FK→Users)         │   │────────────────────────────────│
  │ LoginTime (DATETIME)          │   │ Id (PK)                       │
  │ LogoutTime (DATETIME?)        │   │ UserId (FK→Users, SET NULL)   │
  └───────────────────────────────┘   │ Action (NVARCHAR 100)         │
                                      │ EntityName (NVARCHAR 100)     │
                                      │ EntityId (INT?)               │
                                      │ OldValues (NTEXT?)            │
                                      │ NewValues (NTEXT?)            │
                                      │ IpAddress (NVARCHAR?)         │
                                      │ Timestamp (DATETIME)          │
                                      └────────────────────────────────┘
                                      
     ┌─── ASP.NET Core Identity Tables ───────────────────────────────┐
     │  ROLES | USER_ROLES | USER_CLAIMS | USER_LOGINS               │
     │  USER_TOKENS | ROLE_CLAIMS                                     │
     └────────────────────────────────────────────────────────────────┘
     
Figure 3.1: Entity-Relationship Diagram (ERD) – SmartElderlyCare Database
""", size=8)

    add_paragraph(doc, "Caption: Figure 3.1 – Entity-Relationship Diagram showing all 12 domain entities, their attributes, and relationships in the SmartElderlyCare database.", size=10, italic=True)

    add_heading(doc, "3.1.2  Entity Descriptions", 3)
    entities_desc = [
        ("Users", "Extends ASP.NET Core IdentityUser<int>. Stores all system user accounts including Admins, Team Leaders, Employees, and Family Members. Includes FirstName, LastName, UserType (enum), IsActive, soft-delete fields, and LastLoginAt."),
        ("Roles", "Extends ASP.NET Core IdentityRole<int>. Stores system roles: Admin, TeamLeader, Employee, FamilyMember."),
        ("Elderlies", "Stores elderly resident profiles including personal information, medical conditions, allergies, dietary restrictions, room assignment, emergency contact, profile image URL, and a unique 6-character ConnectionCode used for family self-registration."),
        ("DailyReports", "Stores daily health care reports submitted by employees for assigned elderly residents. Includes report date, submission date, approval status, AI-generated narrative report, structured JSON data, and approval/rejection workflow fields."),
        ("HealthMetrics", "Stores individual health observations within a daily report. Each metric has a type (Meal, Medication, Activity, Symptom, Vital, Mood), name, value, unit, notes, and recorded time."),
        ("EmployeeElderlyAssignments", "Many-to-many join table linking employees to elderly residents. Supports composite PK (EmployeeId, ElderlyId), assignment date, end date, and primary caregiver flag."),
        ("ElderlyFamilyMembers", "Many-to-many join table linking family member users to elderly residents. Records the relationship type (Son, Daughter, Spouse, etc.), primary contact flag, and visit permission flag."),
        ("WorkSchedules", "Stores employee shift schedules created by team leaders. Includes shift date, start/end times, shift type (Morning, Afternoon, Night, Overnight, OffDay), and creator/updater references."),
        ("AttendanceLogs", "Records employee clock-in and clock-out timestamps. LogDate is a computed column derived from LoginTime."),
        ("VisitRequests", "Stores family visit requests submitted by family members. Includes requested date/time, duration, status (Pending/Approved/Rejected/Cancelled/Completed), and approval/rejection tracking."),
        ("Notifications", "Stores in-app notifications for all users. Each notification has a type (HealthAlert, ReportApproved, ReportRejected, VisitRequest, ScheduleChange, General), read status, and optional related entity reference."),
        ("AuditLogs", "Permanent (not soft-deleted) system audit records. Logs every significant action with user ID, action type, entity name, entity ID, old values JSON, new values JSON, IP address, and timestamp."),
    ]
    add_styled_table(doc, ["Entity", "Description"], entities_desc)

    add_heading(doc, "3.1.3  Database Relationships", 3)
    relationships = [
        ("Users → DailyReports (as Employee)", "One-to-Many", "RESTRICT", "An employee can submit many daily reports; deletion of user is restricted if reports exist."),
        ("Users → DailyReports (as Approver)", "One-to-Many", "RESTRICT", "A team leader can approve many reports."),
        ("Elderlies → DailyReports", "One-to-Many", "RESTRICT", "An elderly resident can have many daily reports."),
        ("DailyReports → HealthMetrics", "One-to-Many", "CASCADE", "A report contains many health metrics; deleting a report cascades to its metrics."),
        ("Users ↔ Elderlies (via EmployeeElderlyAssignments)", "Many-to-Many", "RESTRICT", "Composite PK (EmployeeId, ElderlyId); employees can be assigned to multiple residents and vice versa."),
        ("Elderlies ↔ Users (via ElderlyFamilyMembers)", "Many-to-Many", "RESTRICT", "Composite PK (ElderlyId, FamilyMemberId); family members can be linked to multiple residents."),
        ("Users → WorkSchedules", "One-to-Many", "RESTRICT", "An employee can have many scheduled shifts."),
        ("Users → AttendanceLogs", "One-to-Many", "RESTRICT", "An employee has many attendance log entries."),
        ("Users → Notifications", "One-to-Many", "CASCADE", "A user has many notifications; deleting a user cascades to their notifications."),
        ("Users → AuditLogs", "One-to-Many", "SET NULL", "Audit logs reference the acting user; if user is deleted, UserId is set to null (records preserved)."),
        ("Elderlies → VisitRequests", "One-to-Many", "RESTRICT", "An elderly resident can have many visit requests."),
    ]
    add_styled_table(doc, ["Relationship", "Cardinality", "Delete Behavior", "Notes"], relationships)

