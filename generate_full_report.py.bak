    add_heading(doc, "6.1.2  Actual Results", 3)
    actual_results = [
        ("Multi-Role System", "✅ ACHIEVED", "All four user roles fully implemented with dedicated dashboards, controllers, and service layers. Role-based routing enforced in both backend (JWT claims) and frontend (React Router protected routes)."),
        ("JWT Authentication", "✅ ACHIEVED", "Complete authentication flow implemented: login, logout, register, change-password, forgot-password, reset-password. Account lockout after 5 failed attempts operational."),
        ("AI Health Risk Prediction", "✅ ACHIEVED", "Random Forest model trained on 500+ records. Hybrid clinical rule engine with 9 override conditions. Celsius/Fahrenheit auto-conversion. Markdown clinical reports generated. Audit logging to CSV."),
        ("AI Dietary Recommendation", "✅ ACHIEVED", "Random Forest meal classifiers for breakfast, lunch, dinner. Allergen safety filter with fallback. Dynamic BMI analysis. Personalised dietitian notes in Markdown. Dynamic recipe bank (CRUD + on-the-fly retraining)."),
        ("Gemini AI Report Generation", "✅ ACHIEVED", "Full Gemini API integration with structured prompts. Fallback template generator for offline scenarios. Pattern detection across multiple reports."),
        ("SignalR Real-Time Notifications", "✅ ACHIEVED", "NotificationHub implemented with user and role groups. Notifications delivered in real-time for all key events. In-database persistence with read/unread tracking."),
        ("Report Approval Workflow", "✅ ACHIEVED", "Employee creates report → TeamLeader reviews → Approves/Rejects with reason → Employee and Family notified. Status tracking (Pending/Approved/Rejected) fully operational."),
        ("Family Portal", "✅ ACHIEVED", "Self-registration with ConnectionCode. Approved report viewing. Health trend charts. Visit request management (create/update/cancel). Real-time notifications."),
        ("Audit Logging", "✅ ACHIEVED", "Complete audit trail with userId, action, entityName, entityId, oldValues, newValues, IpAddress, Timestamp. Permanent records (not soft-deleted)."),
        ("Admin Dashboard", "✅ ACHIEVED", "System statistics, user management, elderly management, assignment management, visit oversight, audit logs, activity summary all implemented."),
        ("Fall Detection (Prototype)", "⚠️ PARTIAL", "Bounding-box aspect ratio heuristic implemented as prototype. Full CV model integration (YOLOv8-pose) planned for future work."),
    ]
    add_styled_table(doc, ["Feature", "Status", "Notes"], actual_results)

    add_heading(doc, "6.2  Discussion", 2)

    add_heading(doc, "6.2.1  Strengths", 3)
    strengths = [
        ("Architecture Quality", "The Clean Architecture implementation provides excellent separation of concerns. Each layer is independently testable and the domain model remains technology-agnostic. The Generic Repository and Unit of Work patterns further improve code reuse and testability."),
        ("AI Integration Depth", "The project goes beyond typical graduation-project scope by implementing three distinct AI capabilities: ML-based health risk prediction, ML-based dietary recommendations, and LLM-powered report generation. The hybrid clinical rule engine adds a critical patient safety layer."),
        ("Real-Time Communication", "The SignalR notification system is seamlessly integrated into the workflow, ensuring that critical health alerts reach caregivers within seconds without requiring page refreshes."),
        ("Family Transparency", "The family portal is a culturally significant feature for the target demographic, addressing the need for families to stay informed about their elderly relatives without compromising privacy or care workflow."),
        ("Security Implementation", "JWT authentication, RBAC, API key protection on the AI microservice, account lockout, and soft-delete data preservation represent a production-quality security posture for an academic project."),
        ("Dynamic AI Model Management", "The ability to add new recipes, retrain the meal recommender model on-the-fly without restarting the service, and the fallback mechanisms demonstrate robust production-oriented design thinking."),
        ("Comprehensive Documentation", "Full Swagger documentation, XML doc comments on all public API methods, and this graduation report provide exceptional documentation coverage."),
    ]
    add_styled_table(doc, ["Strength", "Analysis"], strengths)

    add_heading(doc, "6.2.2  Weaknesses and Limitations", 3)
    weaknesses = [
        ("AI Training Data Volume", "The health risk model was trained on ~500 synthetic records. Real-world clinical deployment would require significantly larger, validated datasets (10,000+ records) with approval from medical professionals."),
        ("Fall Detection Prototype", "The current fall detection uses a geometric heuristic rather than actual computer vision. A production-ready implementation would require pose estimation models (MediaPipe, YOLOv8-pose) and camera integration."),
        ("No Refresh Token", "The current JWT implementation uses single access tokens with 60-minute expiry. Production systems should implement refresh token rotation to balance security and user experience."),
        ("CORS Policy", "The development CORS policy allows all origins. Production deployment requires restricting this to the specific hosting domain."),
        ("No End-to-End Encryption for Health Data", "While HTTPS encrypts data in transit and the database is on a trusted server, end-to-end encryption for health metrics is not implemented. This would be essential for HIPAA or GDPR compliance."),
        ("Limited Load Testing", "Performance benchmarks were conducted on a single local machine. Distributed load testing (e.g., using k6 or JMeter with simulated concurrent users) was not performed."),
        ("No Offline Support", "The React.js frontend is a standard SPA without Progressive Web App (PWA) features. Offline capability would be valuable in environments with intermittent connectivity."),
    ]
    add_styled_table(doc, ["Weakness/Limitation", "Analysis"], weaknesses)

    add_page_break(doc)

    # ══════════════════════════════════════════════════════════════════════════
    # CHAPTER 7: CONCLUSION
    # ══════════════════════════════════════════════════════════════════════════
    add_heading(doc, "Chapter 7: Conclusion", 1)

    add_paragraph(doc, """SmartElderlyCare (SilverNest) represents a comprehensive, technically advanced graduation project that successfully achieves its stated objectives of delivering an AI-enhanced eldercare management platform. The system addresses a genuine and growing real-world problem — the need for digital, intelligent, and integrated care management in elderly care facilities — with a solution that is both academically rigorous and practically applicable.

The project demonstrates successful integration of multiple modern technology domains:

Full-Stack Web Development: A production-quality ASP.NET Core 8 Web API implementing Clean Architecture with JWT security, Role-Based Access Control, Entity Framework Core, AutoMapper, and SignalR; paired with a React.js 19 Single Page Application using a professional component library, charting, real-time notifications, and comprehensive form management.

Machine Learning and AI: A Python FastAPI microservice incorporating two trained Random Forest models (health risk classification and meal recommendation) trained on a custom elderly health dataset, supplemented by a hybrid clinical rule engine that enforces patient safety through hard clinical thresholds.

Generative AI Integration: Full integration with Google Gemini API for intelligent narrative report generation from structured health metrics, with automatic fallback mechanisms for offline resilience.

Real-Time Communication: A SignalR WebSocket hub providing instantaneous push notifications to all user roles based on system events, ensuring critical health alerts are received in real-time.

The team successfully delivered all core features within the academic semester, achieving a 100% pass rate across 79 test cases spanning unit, integration, system, performance, security, and user acceptance testing. The only partial implementation is the fall detection computer vision module, which uses a bounding-box geometric heuristic as a prototype pending integration with a full pose-estimation model.

Key lessons learned include the importance of Clean Architecture for managing complexity in large projects, the value of incremental AI development (starting with rule-based fallbacks before ML), the critical role of real-time communication in healthcare applications, and the need for thorough API contract design before frontend development begins.

The SmartElderlyCare system is ready for academic submission and, with the production hardening items noted in the Future Work chapter, could be deployed in a real care facility context. It stands as evidence of the team's mastery of modern full-stack software engineering, applied AI, and healthcare domain knowledge.""", size=11)

    add_page_break(doc)

    # ══════════════════════════════════════════════════════════════════════════
    # CHAPTER 8: FUTURE WORK
    # ══════════════════════════════════════════════════════════════════════════
    add_heading(doc, "Chapter 8: Future Work", 1)

    future_items = [
        ("Real Computer Vision Fall Detection",
         "Replace the current bounding-box geometric heuristic with a production-grade pose estimation model. Candidate technologies include YOLOv8-Pose (Ultralytics), MediaPipe Pose (Google), or OpenPose. The system would integrate with IP cameras in resident rooms and process video streams in real-time, triggering instant alerts to caregivers upon fall detection. This is the most critical near-term enhancement for resident safety."),
        ("Refresh Token Authentication",
         "Implement a secure refresh token rotation mechanism to extend sessions without compromising security. Access tokens would remain short-lived (15 minutes), with refresh tokens (24 hours) stored in secure HttpOnly cookies. This significantly improves user experience without sacrificing security posture."),
        ("Expanded AI Training Dataset",
         "Retrain the health risk prediction model on a larger, clinically validated dataset (target: 10,000+ records) in collaboration with healthcare professionals. Incorporate more diverse health conditions, medications, and demographic factors. Consider federated learning approaches to train on data from multiple care facilities without centralising sensitive health data."),
        ("Native Mobile Applications",
         "Develop React Native mobile applications for iOS and Android to extend the system's reach to mobile-first users. Key use cases: family members checking on loved ones via smartphone, employees submitting reports from tablets while at the bedside, and push notifications on mobile devices."),
        ("IoT Wearable Integration",
         "Integrate with wearable health monitoring devices (smartwatches, medical-grade vital sign monitors) to enable continuous, automated health data collection rather than manual entry. Target metrics: real-time heart rate, SpO2 (blood oxygen), continuous blood pressure monitoring, sleep tracking, and movement/activity recognition."),
        ("Predictive Analytics and Trend Analysis",
         "Build a longitudinal health analytics module that applies time-series analysis to historical health metrics, generating predictive alerts for declining trends before they become acute. For example, detecting a gradual decrease in meal consumption over 5 days before it triggers a critical alert."),
        ("Multi-Language Support (Arabic)",
         "Implement full Arabic language support (RTL layout) throughout the frontend, making the system accessible to Arabic-speaking staff and family members in Egypt and the broader Arab world. The Gemini AI report generation would be extended to support Arabic-language clinical narratives."),
        ("Cloud Deployment (Azure / AWS)",
         "Migrate the system to a cloud platform (Azure App Service, Azure SQL, Azure SignalR Service, Azure Container Registry) for production deployment. Implement container orchestration (Docker Compose or Kubernetes) for the multi-service architecture. Set up CI/CD pipelines (GitHub Actions) for automated testing and deployment."),
        ("Telemedicine Integration",
         "Integrate a video consultation feature enabling family members and remote physicians to conduct virtual visits and consultations through the platform, reducing the need for physical visits while maintaining family connection."),
        ("Medication Management Module",
         "Develop a dedicated medication management module with medication schedules, automated reminder notifications, drug interaction checking via OpenFDA API, and integration with pharmacy dispensing systems."),
        ("Occupational Therapy Tracking",
         "Add structured occupational therapy and physiotherapy session tracking, allowing therapists to log progress, set goals, and monitor improvement over time within the resident's longitudinal health record."),
        ("Family Communication Portal",
         "Extend the family portal with a secure messaging system enabling direct communication between family members and care staff, replacing informal phone calls with a documented, auditable communication channel."),
    ]

    for i, (title, desc) in enumerate(future_items, 1):
        add_heading(doc, f"8.{i}  {title}", 3)
        add_paragraph(doc, desc, size=11)

    add_page_break(doc)

