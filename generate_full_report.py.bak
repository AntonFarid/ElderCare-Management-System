    # APPENDICES
    # ══════════════════════════════════════════════════════════════════════════
    add_heading(doc, "Appendix A: Database Schema", 1)
    add_paragraph(doc, "The following SQL DDL represents the database schema generated by Entity Framework Core migrations for SmartElderlyCare:", size=11)

    schema_sql = """-- USERS TABLE (Extends ASP.NET Core Identity)
CREATE TABLE [Users] (
    [Id]           INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [FirstName]    NVARCHAR(100) NOT NULL,
    [LastName]     NVARCHAR(100) NOT NULL,
    [UserType]     INT NOT NULL,           -- 1=Admin, 2=TeamLeader, 3=Employee, 4=FamilyMember
    [IsActive]     BIT NOT NULL DEFAULT 1,
    [CreatedAt]    DATETIME2 NOT NULL,
    [UpdatedAt]    DATETIME2 NULL,
    [CreatedBy]    NVARCHAR(MAX) NOT NULL DEFAULT '',
    [UpdatedBy]    NVARCHAR(MAX) NULL,
    [IsDeleted]    BIT NOT NULL DEFAULT 0,
    [DeletedAt]    DATETIME2 NULL,
    [LastLoginAt]  DATETIME2 NULL,
    -- Identity columns (Email, PasswordHash, PhoneNumber, etc.)
);

-- ELDERLIES TABLE
CREATE TABLE [Elderlies] (
    [Id]                   INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [FirstName]            NVARCHAR(100) NOT NULL,
    [LastName]             NVARCHAR(100) NOT NULL,
    [DateOfBirth]          DATETIME2 NOT NULL,
    [RoomNumber]           NVARCHAR(MAX) NULL,
    [EmergencyContact]     NVARCHAR(MAX) NULL,
    [MedicalConditions]    NVARCHAR(MAX) NULL,
    [Allergies]            NVARCHAR(MAX) NULL,
    [DietaryRestrictions]  NVARCHAR(MAX) NULL,
    [ProfileImageUrl]      NVARCHAR(MAX) NULL,
    [ConnectionCode]       NVARCHAR(MAX) NOT NULL,    -- 6-char unique code
    [IsActive]             BIT NOT NULL DEFAULT 1,
    [IsDeleted]            BIT NOT NULL DEFAULT 0,
    [DeletedAt]            DATETIME2 NULL,
    [CreatedAt]            DATETIME2 NOT NULL,
    [UpdatedAt]            DATETIME2 NULL,
    [CreatedBy]            NVARCHAR(MAX) NOT NULL DEFAULT '',
    [UpdatedBy]            NVARCHAR(MAX) NULL,
);

-- DAILY_REPORTS TABLE
CREATE TABLE [DailyReports] (
    [Id]                  INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [EmployeeId]          INT NOT NULL REFERENCES [Users]([Id]) ON DELETE RESTRICT,
    [ElderlyId]           INT NOT NULL REFERENCES [Elderlies]([Id]) ON DELETE RESTRICT,
    [ReportDate]          DATETIME2 NOT NULL,
    [SubmissionDate]      DATETIME2 NOT NULL,
    [ApprovalStatus]      INT NOT NULL DEFAULT 1,   -- 1=Pending, 2=Approved, 3=Rejected
    [ApprovedById]        INT NULL REFERENCES [Users]([Id]) ON DELETE RESTRICT,
    [ApprovedDate]        DATETIME2 NULL,
    [RejectionReason]     NVARCHAR(MAX) NULL,
    [AiGeneratedReport]   NVARCHAR(MAX) NOT NULL DEFAULT '',
    [StructuredData]      NVARCHAR(MAX) NOT NULL DEFAULT '',
    [IsDeleted]           BIT NOT NULL DEFAULT 0,
    [DeletedAt]           DATETIME2 NULL,
    [CreatedAt]           DATETIME2 NOT NULL,
    [UpdatedAt]           DATETIME2 NULL,
    [CreatedBy]           NVARCHAR(MAX) NOT NULL DEFAULT '',
    [UpdatedBy]           NVARCHAR(MAX) NULL,
);

-- HEALTH_METRICS TABLE
CREATE TABLE [HealthMetrics] (
    [Id]            INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [DailyReportId] INT NOT NULL REFERENCES [DailyReports]([Id]) ON DELETE CASCADE,
    [MetricType]    INT NOT NULL,  -- 1=Meal, 2=Medication, 3=Activity, 4=Symptom, 5=Vital, 6=Mood
    [MetricName]    NVARCHAR(MAX) NOT NULL,
    [MetricValue]   NVARCHAR(MAX) NOT NULL,
    [Unit]          NVARCHAR(MAX) NULL,
    [Notes]         NVARCHAR(MAX) NULL,
    [RecordedTime]  TIME NOT NULL,
    [CreatedAt]     DATETIME2 NOT NULL,
    [UpdatedAt]     DATETIME2 NULL,
);

-- NOTIFICATIONS TABLE
CREATE TABLE [Notifications] (
    [Id]                  INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [UserId]              INT NOT NULL REFERENCES [Users]([Id]) ON DELETE CASCADE,
    [Title]               NVARCHAR(MAX) NOT NULL,
    [Message]             NVARCHAR(MAX) NOT NULL,
    [NotificationType]    INT NOT NULL,  -- 1=HealthAlert, 2=Approved, 3=Rejected, 4=Visit, 5=Schedule, 6=General
    [IsRead]              BIT NOT NULL DEFAULT 0,
    [RelatedEntityId]     INT NULL,
    [RelatedEntityType]   NVARCHAR(MAX) NULL,
    [IsDeleted]           BIT NOT NULL DEFAULT 0,
    [CreatedAt]           DATETIME2 NOT NULL,
    [UpdatedAt]           DATETIME2 NULL,
);

-- AUDIT_LOGS TABLE (permanent, never deleted)
CREATE TABLE [AuditLogs] (
    [Id]          INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [UserId]      INT NULL REFERENCES [Users]([Id]) ON DELETE SET NULL,
    [Action]      NVARCHAR(100) NOT NULL,
    [EntityName]  NVARCHAR(100) NOT NULL,
    [EntityId]    INT NULL,
    [OldValues]   NVARCHAR(MAX) NULL,
    [NewValues]   NVARCHAR(MAX) NULL,
    [IpAddress]   NVARCHAR(MAX) NULL,
    [Timestamp]   DATETIME2 NOT NULL,
    [CreatedAt]   DATETIME2 NOT NULL,
);"""

    p = doc.add_paragraph()
    run = p.add_run(schema_sql)
